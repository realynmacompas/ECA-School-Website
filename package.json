{
  "name": "eca-school-website",
  "private": true,
  "description": "Elim Christian Academy website + admin. Static front end; back end in /api (Vercel Functions) with MySQL.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --env-file=.env.local scripts/dev-server.js",
    "env:check": "node scripts/check-env.js",
    "db:setup": "node --env-file=.env.local scripts/db.js setup",
    "admin:add": "node --env-file=.env.local scripts/db.js add-admin",
    "admin:remove": "node --env-file=.env.local scripts/db.js remove-admin",
    "admin:list": "node --env-file=.env.local scripts/db.js list-admins"
  },
  "dependencies": {
    "google-auth-library": "^9.15.1",
    "mysql2": "^3.12.0"
  }
}
