# =========================================================
# ECA Website - back end settings
#
# Copy this file to ".env.local" for testing on your computer
# (npm run dev). On Vercel, add the same names under
# Project > Settings > Environment Variables.
#
# NEVER commit .env.local or real values to GitHub.
# Switching from personal to school accounts later = change
# these values only. No code changes.
# =========================================================

# --- Google sign-in -------------------------------------------------
# Same Client ID as admin/js/auth-config.js (Google Cloud > Credentials)
GOOGLE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com

# --- Admin sessions -------------------------------------------------
# A long random secret used to sign the sign-in cookie.
# Make one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out.
SESSION_SECRET=paste-a-long-random-value-here
# How long a sign-in lasts (hours). Optional, default 8.
SESSION_HOURS=8

# --- MySQL database -------------------------------------------------
# Aiven: Service > Overview > Connection information > "Service URI"
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://avnadmin:password@your-service.aivencloud.com:12345/defaultdb
# Aiven requires a secure connection, using Aiven's "CA certificate".
#
# On your computer (easiest): Aiven > Overview > CA certificate > Download.
# Put ca.pem in this project folder (it won't be uploaded) and use:
DATABASE_CA_CERT_FILE=ca.pem
#
# On Vercel: add DATABASE_CA_CERT instead and paste the whole certificate
# (open ca.pem in VS Code, copy everything, paste with its line breaks).
# DATABASE_CA_CERT=
# Only for a database on your own computer (XAMPP, etc.) that has no SSL:
# DATABASE_SSL=off
